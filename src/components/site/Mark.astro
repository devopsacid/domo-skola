---
/**
 * Brand mark (placeholder geometry, docs/design/mark.svg). Decorative: the brand
 * link or caption carries the name. Colours come from CSS (.mark tokens), so the
 * inverse lock-up on forest/night needs no second file. No style attributes.
 */
interface Props {
  size?: 'm' | 'l';
  class?: string;
}
const { size = 'm', class: className } = Astro.props;
---

<svg
  class:list={['mark', size === 'l' && 'mark--l', className]}
  viewBox="0 0 64 64"
  width="36"
  height="36"
  aria-hidden="true"
  focusable="false"
>
  <path
    class="mark__pebble"
    d="M33.5 3.5c13.6.6 25.3 9.9 27 23.4 1.8 14.3-7.1 29.6-22.2 32.6C23.6 62.4 7.4 55.9 4.1 40.6 1 26 8.2 11.7 20.6 6.2c4.1-1.8 8.5-2.9 12.9-2.7Z"
  ></path>
  <path
    class="mark__clearing"
    d="M33.2 15.8c8.4.3 14.7 6.8 14.4 14.8-.3 8.3-7.3 14.3-15.6 13.9-8.1-.4-13.9-7-13.6-14.9.3-8.1 6.8-14.1 14.8-13.8Z"
  ></path>
  <path
    class="mark__meadow"
    d="M18.6 33.6c3.6-2.6 8-3.9 12.6-3.6 6.3.4 11.9 3.6 16.1 7.9-2.3 4-6.5 6.6-15.3 6.6-7.2-.3-12.1-5-13.4-10.9Z"
  ></path>
  <circle class="mark__sun" cx="38.6" cy="23.8" r="4.2"></circle>
</svg>
