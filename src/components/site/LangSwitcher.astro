---
/**
 * Language switcher: plain links (no <select>, no JS). Each link carries lang and
 * hreflang; the compact variant shows SK/CS/EN with the full name for assistive tech.
 * Hrefs come from switcherHref() (equivalent page, or the locale home / blog index).
 * The current language links to this very page, so it carries aria-current="page".
 */
import { LOCALES, type Locale } from '../../i18n/routes';
import { chrome } from './strings';

interface Props {
  locale: Locale;
  hrefs: Record<Locale, string>;
  variant?: 'compact' | 'full';
  label?: string;
  /**
   * Render without the <nav> landmark (a plain list under a visible heading), for a
   * second switcher on the page: two landmarks with the same name fail axe
   * landmark-unique (header "Jazyk" vs footer "Jazyk").
   */
  bare?: boolean;
  class?: string;
}
const { locale, hrefs, variant = 'compact', label, bare = false, class: className } = Astro.props;
const Wrap = bare ? 'div' : 'nav';
const t = chrome(locale);
---

<Wrap class={className} aria-label={bare ? undefined : (label ?? t.languageNav)}>
  <ul class:list={['lang-switch', variant === 'full' && 'lang-switch--full']}>
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={hrefs[l]}
            lang={l}
            hreflang={l}
            aria-current={l === locale ? 'page' : undefined}
          >
            {variant === 'compact' ? (
              <>
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="visually-hidden">{t.languageNames[l]}</span>
              </>
            ) : (
              t.languageNames[l]
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Wrap>
