---
/** L. Final conversion band on the night surface, continuous with the footer. */
import { localePath, type Locale } from '../../i18n/routes';
import Reviewable from '../status/Reviewable.astro';
import Mark from '../site/Mark.astro';
import type { HomeSections } from './content';

interface Props {
  locale: Locale;
  data: HomeSections['finalCta'];
}
const { locale, data } = Astro.props;
---

<section class="section surface-night home-final" aria-labelledby="home-final-title">
  <Reviewable locale={locale} status={data.status} name="pages/home.finalCta" quiet class="container home-final__inner">
    <Mark size="l" class="home-final__mark" />
    <h2 class="home-final__title" id="home-final-title">{data.title}</h2>
    <p class="home-final__text">{data.text}</p>
    <div class="btn-group home-final__ctas">
      <a class="btn btn-primary" href={localePath('enrol', locale)}>{data.ctaPrimary}</a>
      <a class="btn btn-secondary" href={`${localePath('contact', locale)}?subject=visit`}>{data.ctaSecondary}</a>
    </div>
  </Reviewable>
</section>
