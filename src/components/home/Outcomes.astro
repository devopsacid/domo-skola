---
/** E. What children develop: a typographic list of eight, no icon grid (brand.md §7). */
import type { Locale } from '../../i18n/routes';
import Reviewable from '../status/Reviewable.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { HomeSections } from './content';

interface Props {
  locale: Locale;
  data: HomeSections['outcomes'];
}
const { locale, data } = Astro.props;
---

<section class="section home-outcomes" aria-labelledby="home-outcomes-title">
  <Reviewable locale={locale} status={data.status} name="pages/home.outcomes" quiet class="container">
    <SectionHeading eyebrow={data.eyebrow} title={data.title} id="home-outcomes-title" landing>
      <p>{data.intro}</p>
    </SectionHeading>
    <ul class="outcome-list">
      {
        data.items.map((it) => (
          <li class="outcome">
            <h3 class="outcome__title">{it.title}</h3>
            <p class="outcome__text">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </Reviewable>
</section>
