---
import { LOCALES, type Locale } from '../../i18n/routes';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
// Placeholder until L3 builds the home sections.
const placeholder: Record<Locale, string> = {
  sk: 'Pripravujeme',
  cs: 'Připravujeme',
  en: 'Coming soon',
};
---

<Base locale={locale} page={{ key: 'home', locale }}>
  <section class="section">
    <div class="container">
      <h1>{placeholder[locale]}</h1>
    </div>
  </section>
</Base>
